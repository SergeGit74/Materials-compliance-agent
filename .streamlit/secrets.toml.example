# Copy these names into the app's Secrets box on Streamlit Community Cloud (Settings > Secrets), or into .streamlit/secrets.toml
# for a local test. Fill the values yourself. Never commit the real file (.gitignore excludes it).
# Order of lookup: environment variable, then these secrets, then .env.

ANTHROPIC_API_KEY = ""
SERPER_API_KEY = ""            # optional: without it the Anthropic web search tool is used
MODEL_NORMALIZE = ""
MODEL_REASON = ""
MODEL_VERIFY = ""

# The checks in src/config.py also need these (same values as .env.example):
VOYAGE_API_KEY = ""            # Voyage is not used for reranking, but the startup check still requires a value
VOYAGE_EMBED_MODEL = ""
RULES_LANGUAGE = "en"
RULES_JURISDICTION = "dubai"
MAX_STEPS_PER_ITEM = ""
MAX_TOKENS_PER_ITEM = ""
# USE_VOYAGE_RERANK = "1"      # leave unset: Haiku reranking is used and Voyage is skipped

# Public demo mode
DEMO_MODE = "true"
DEMO_PASSCODE = ""             # visitors need it to switch the real models on
DEMO_MAX_REAL_ITEMS_PER_SESSION = "10"
DEMO_MAX_REAL_ITEMS_PER_DAY = "30"
