# Copy to .env and fill in. Never commit .env.
# Phase 1 (interactive Claude Code) needs none of these.

# Required from Phase 2
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Optional: Google search API for producer discovery (falls back to Anthropic web search if empty)
SERPER_API_KEY=

# Models (confirm names in Anthropic's current model list)
MODEL_NORMALIZE=claude-haiku-5-5
MODEL_REASON=claude-sonnet-5-5
MODEL_VERIFY=claude-opus-5-5

# Embeddings (take the current model name from Voyage's documentation)
VOYAGE_EMBED_MODEL=

# Scope (must not change)
RULES_LANGUAGE=en
RULES_JURISDICTION=dubai

# Budgets per item
MAX_STEPS_PER_ITEM=15
MAX_TOKENS_PER_ITEM=300000
